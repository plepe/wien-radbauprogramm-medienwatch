    "prepare": "npm run build"
  },
  "dependencies": {
    "argparse": "^2.0.1",
    "async": "^3.2.6",
    "browserify": "^17.0.1",
    "drupal-rest": "github:plepe/drupal-rest-js",
    "esmify": "^2.1.1",
    "jsdom": "^21.1.1",
    "standard": "^17.0.0",
    "twitter-unroll-html": "github:plepe/twitter-unroll-html",
    "watchify": "^4.0.0"
  }
}
